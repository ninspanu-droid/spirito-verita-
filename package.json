{
  "name": "spirito-verita",
  "version": "1.0.42",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:date-migration": "node --test tests/legacySqliteDate.test.cjs",
    "test:diary-migration": "node --test tests/legacySqliteMigration.integration.test.cjs tests/legacySqliteDate.test.cjs",
    "test:sqlcipher-gate": "node --test tests/sqlCipherMigrationGate.test.cjs",
    "test:all": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:sqlcipher-bootstrap": "node --test tests/sqlCipherBootstrap.static.test.cjs",
    "test:sqlcipher-key": "node --test tests/sqlCipherKey.test.cjs",
    "check:native-build": "node scripts/check-native-build.cjs",
    "prebuild:native": "expo prebuild",
    "build:android:eas": "eas build --platform android --profile development",
    "build:ios:eas": "eas build --platform ios --profile development",
    "test:release-gate": "node --test tests/releaseGate.static.test.cjs",
    "diagnose:native": "node scripts/diagnose-native-environment.cjs",
    "test:ci": "npm run test:all && npm run typecheck",
    "verify:lockfile": "node scripts/verify-lockfile.cjs",
    "check:app-identifiers": "node scripts/check-app-identifiers.cjs",
    "check:release-config": "node scripts/check-release-config.cjs",
    "check:eas-project": "node scripts/check-eas-project.cjs",
    "check:release-readiness": "node scripts/check-release-readiness.cjs",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "check:first-build": "npm run test:all && npm run check:release-readiness",
    "check:environment": "node scripts/diagnose-native-environment.cjs",
    "check:reproducible-install": "node scripts/check-reproducible-install.cjs",
    "set:eas-project": "node scripts/set-eas-project-id.cjs",
    "check:build-inputs": "node scripts/check-build-inputs.cjs",
    "check:crypto-runtime": "node scripts/check-crypto-runtime.cjs",
    "diagnose:dependencies": "node scripts/diagnose-dependency-environment.cjs",
    "check:android-local": "node scripts/check-android-local.cjs",
    "generate:lockfile": "node scripts/generate-lockfile-retry.cjs",
    "check:repository-readiness": "node scripts/check-repository-readiness.cjs",
    "check:handoff": "node scripts/check-github-eas-handoff.cjs",
    "check:github-publish": "node scripts/check-github-publish.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@noble/ciphers": "^1.2.1",
    "@noble/hashes": "^1.7.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "base64-js": "^1.5.1",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-document-picker": "~13.1.5",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-sharing": "~13.1.5",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "query-string": "7.1.3",
    "react": "19.0.0",
    "react-dom": "19.3.1",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
